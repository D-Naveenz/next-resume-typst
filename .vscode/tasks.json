{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Typst: Watch All",
      "dependsOn": [
        "Typst: Watch CV",
        "Typst: Watch Letter"
      ],
      "dependsOrder": "parallel",
      "runOptions": {
        "reevaluateOnRerun": true,
        "runOn": "folderOpen",
        "instanceLimit": 1
      },
      "problemMatcher": []
    },
    {
      "label": "Build: CV Final",
      "dependsOn": [
        "Typst: Compile CV",
        "Postprocess: CV"
      ],
      "dependsOrder": "sequence",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Typst: Compile CV",
      "type": "shell",
      "command": "typst",
      "args": [
        "compile",
        "--font-path",
        "${workspaceFolder}/fonts",
        "${workspaceFolder}/cv.typ",
        "${workspaceFolder}/cv.pdf"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Postprocess: CV",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "${workspaceFolder}\\tools\\next_resume_postprocess.py",
        "process",
        "--document",
        "cv",
        "--pdf",
        "${workspaceFolder}\\cv.pdf",
        "--input",
        "language=en",
        "--in-place"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Typst: Watch CV",
      "type": "shell",
      "command": "typst",
      "args": [
        "watch",
        "--font-path",
        "${workspaceFolder}/fonts",
        "${workspaceFolder}/cv.typ",
        "${workspaceFolder}/cv.pdf"
      ],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Postprocess: Watch CV",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "${workspaceFolder}\\tools\\next_resume_postprocess.py",
        "watch",
        "--document",
        "cv",
        "--pdf",
        "${workspaceFolder}\\cv.pdf",
        "--input",
        "language=en"
      ],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Watch: CV Final",
      "dependsOn": [
        "Typst: Watch CV",
        "Postprocess: Watch CV"
      ],
      "dependsOrder": "parallel",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Typst: Compile Letter",
      "type": "shell",
      "command": "typst",
      "args": [
        "compile",
        "--font-path",
        "${workspaceFolder}/fonts",
        "${workspaceFolder}/letter.typ",
        "${workspaceFolder}/letter.pdf"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Typst: Watch Letter",
      "type": "shell",
      "command": "typst",
      "args": [
        "watch",
        "--font-path",
        "${workspaceFolder}/fonts",
        "${workspaceFolder}/letter.typ",
        "${workspaceFolder}/letter.pdf"
      ],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
