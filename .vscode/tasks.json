{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Tool: Open TUI",
      "type": "process",
      "command": "${config:nextresume.toolLauncher}",
      "args": ["tui"],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Tool: Doctor",
      "type": "process",
      "command": "${config:nextresume.toolLauncher}",
      "args": ["doctor"],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Tool: Build CV Final",
      "type": "process",
      "command": "${config:nextresume.toolLauncher}",
      "args": ["build", "cv", "--language", "en"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Tool: Build Letter",
      "type": "process",
      "command": "${config:nextresume.toolLauncher}",
      "args": ["build", "letter", "--language", "en"],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Tool: Build All",
      "type": "process",
      "command": "${config:nextresume.toolLauncher}",
      "args": ["build", "all", "--language", "en"],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Tool: Watch CV Final",
      "type": "process",
      "command": "${config:nextresume.toolLauncher}",
      "args": ["watch", "cv", "--language", "en"],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Tool: Watch Letter",
      "type": "process",
      "command": "${config:nextresume.toolLauncher}",
      "args": ["watch", "letter", "--language", "en"],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Tool: Watch All",
      "type": "process",
      "command": "${config:nextresume.toolLauncher}",
      "args": ["watch", "all", "--language", "en"],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Tool: Generate Footer",
      "type": "process",
      "command": "${config:nextresume.toolLauncher}",
      "args": ["footer", "generate"],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Tool: Clean Tooling",
      "type": "process",
      "command": "${config:nextresume.toolLauncher}",
      "args": ["clean"],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Tool: Clean Tooling All",
      "type": "process",
      "command": "${config:nextresume.toolLauncher}",
      "args": ["clean", "--all"],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
