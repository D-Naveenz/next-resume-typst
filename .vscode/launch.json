{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "debugpy",
      "request": "launch",
      "name": "Tool: Debug TUI",
      "python": "${config:nextresume.toolPython}",
      "module": "nextresume_tool",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}\\tools\\src"
      },
      "preLaunchTask": "Tool: Doctor"
    },
    {
      "type": "debugpy",
      "request": "launch",
      "name": "Tool: Debug Build CV",
      "python": "${config:nextresume.toolPython}",
      "module": "nextresume_tool",
      "args": ["build", "cv", "--language", "en"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}\\tools\\src"
      },
      "preLaunchTask": "Tool: Doctor"
    },
    {
      "type": "debugpy",
      "request": "launch",
      "name": "Tool: Debug Footer Generate",
      "python": "${config:nextresume.toolPython}",
      "module": "nextresume_tool",
      "args": ["footer", "generate"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}\\tools\\src"
      },
      "preLaunchTask": "Tool: Doctor"
    },
    {
      "type": "myriaddreamin.typst-debugger",
      "request": "launch",
      "name": "Debug CV",
      "program": "${workspaceFolder}/cv.typ",
      "stopOnEntry": true
    },
    {
      "type": "myriaddreamin.typst-debugger",
      "request": "launch",
      "name": "Debug Letter",
      "program": "${workspaceFolder}/letter.typ",
      "stopOnEntry": true
    },
    {
      "type": "myriaddreamin.typst-debugger",
      "request": "launch",
      "name": "Ask for file name",
      "program": "${workspaceFolder}/${command:AskForProgramName}",
      "stopOnEntry": true
    }
  ]
}
